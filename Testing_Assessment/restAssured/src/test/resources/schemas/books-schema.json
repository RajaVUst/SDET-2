{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["isbn", "title", "author"],
        "properties": {
          "isbn": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
