{
  "$schema": "https://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["books"],
  "properties": {
  "books": {

      "type": "array",

      "items": {

      "type": "object",

      "required": ["isbn","title","subTitle","author","publish_date","publisher",
          "pages","description","website"
        ],

        "properties": {
          "isbn": {
            "type": "string"
          },

          "title": {
            "type": "string"
          },
          "subTitle": {
            "type": "string"
          },

          "author": {
            "type": "string"
          },

          "publish_date": {
            "type": "string"
          },

          "publisher": {
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },

          "description": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        },"additionalProperties" : true
      }
    }
  },"additionalProperties" : true
}